# Copy to web/.env.local and fill in. Everything here is optional: without
# DATABASE_URL the daily game still runs anonymously and the sign-in UI reports
# that accounts are disabled.

# --- accounts -----------------------------------------------------------------
# Enables sign-up / sign-in, subscriptions and the archive.
# DATABASE_URL=postgresql://oirkhon:secret@localhost:5432/oirkhon

# --- Google sign-in (optional) -------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and register this redirect URI:  <origin>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only needed when the public origin differs from the request origin
# (behind a proxy or a custom domain).
# APP_ORIGIN=https://lessgames.mn

# --- data files (optional overrides) -------------------------------------------
# OIRKHON_EXPORT=../data/web/export.json.gz
# OIRKHON_STATE=../data/web/state.json
# OIRKHON_UNKNOWN=../data/web/unknown_words.json
